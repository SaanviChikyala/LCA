# List, tuple, dictionary
student_list=["Amit", "Rahul", "Priya", "Sneha"]
print("\nStudent list:")
print(student_list)

student_tuple=("Amit", "Rahul", "Priya", "Sneha")
print("\nStudent tuple:")
print(student_tuple)

student_dict={
    101:"Amit",
    102:"Rahul",
    103: "Priya",
    104:"Sneha"
}
print("\nStudent dictionary:")
print(student_dict)
student_dict[102]="Rohit"
print(student_dict)
student_dict[105]="Neha"
print(student_dict)
del student_dict[104]
print(student_dict)
